# ============================================================
# InkProof backend environment (backend/.env or deployment env)
# NEVER commit real credentials. The Android app contains NO secrets;
# all keys live only on the backend.
# ============================================================

# Port the backend listens on.
PORT=8787

# Force mock mode (no AI calls, deterministic results).
# Mock mode also activates automatically when no AI key is configured.
MOCK_MODE=true

# --- AI provider (first configured key wins, top to bottom) ---
# PRIMARY: Google Gemini — free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: pin a specific model. Default is the rolling alias
# "gemini-flash-latest" (always the current stable Flash model). If a pinned
# name ever 404s, the backend auto-discovers a current Flash model instead.
GEMINI_MODEL=gemini-flash-latest
# Alternatives (used only if GEMINI_API_KEY is empty):
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Symbolic math verification (optional but recommended) ---
# Wolfram|Alpha App ID: https://developer.wolframalpha.com/
WOLFRAM_APP_ID=

# --- Abuse protection ---
RATE_LIMIT_PER_MINUTE=20

# ============================================================
# Android build (optional): point the app at your deployed backend.
# Pass via Gradle property instead of editing source:
#   ./gradlew assembleDebug -PinkproofBackendUrl=https://your-backend.example.com
# ============================================================
