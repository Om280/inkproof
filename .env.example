# Copy this file to .env in the repository root and fill in your own key.
# Never commit a real key. The Android app does not read this file.
# The backend (backend/server.js) reads it and keeps the key off the device.

# Required for live CHECK MY WORK, SOLVE, and cloud recognition.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Override if Google retires the default. See https://ai.google.dev/gemini-api/docs/models
# Current stable default as of October 2026: Gemini 3.8 Flash.
GEMINI_MODEL=gemini-3.8-flash

# Port the local backend listens on.
PORT=8787
