# ============================================================
# InkProof backend environment (backend/.env or deployment env)
# NEVER commit real credentials. The Android app contains NO secrets;
# all keys live only on the backend.
# ============================================================

# Port the backend listens on.
PORT=8787

# Force mock mode (no AI calls, deterministic results).
# Mock mode also activates automatically when no AI key is configured.
MOCK_MODE=true

# --- AI provider (choose one) ---
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Symbolic math verification (optional but recommended) ---
# Wolfram|Alpha App ID: https://developer.wolframalpha.com/
WOLFRAM_APP_ID=

# --- Abuse protection ---
RATE_LIMIT_PER_MINUTE=20

# ============================================================
# Android build (optional): point the app at your deployed backend.
# Pass via Gradle property instead of editing source:
#   ./gradlew assembleDebug -PinkproofBackendUrl=https://your-backend.example.com
# ============================================================
